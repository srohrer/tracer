# Enables live agent runs. Without it the site still works with the recorded runs.
DEEPSEEK_API_KEY=

# Optional limits on live runs
# RATE_LIMIT_PER_HOUR=10              # per IP
# RATE_LIMIT_GLOBAL_PER_DAY=300

# Optional: durable rate limiting across serverless instances (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
